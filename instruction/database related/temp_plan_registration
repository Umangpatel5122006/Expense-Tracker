 Helpers (private, at the top of the file or inside profile)

 def _parse_iso_date(value):
     """Return a 'YYYY-MM-DD' str if value parses, else
 None."""
     if not value:
         return None
     try:
         datetime.strptime(value, "%Y-%m-%d")
     except ValueError:
         return None
     return value

 def _format_range_label(date_from, date_to):
     """Return 'all time' / 'since <date>' / 'until <date>' /
 '<from> – <to>'.
     Dates are formatted like '9 July 2026'
 (cross-platform)."""
     fmt = lambda s: datetime.strptime(s,
 "%Y-%m-%d").strftime("%d %B %Y").lstrip("0")
     if date_from and date_to:
         return f"{fmt(date_from)} – {fmt(date_to)}"
     if date_from:
         return f"since {fmt(date_from)}"
     if date_to:
         return f"until {fmt(date_to)}"
     return "all time"

 The en-dash – (U+2013) matches the spec's example
 (2026-07-01–2026-07-23). Date formatting reuses the same %d
 %B %Y + lstrip("0") trick already used for member_since, so
 output is consistent and Windows-safe.

